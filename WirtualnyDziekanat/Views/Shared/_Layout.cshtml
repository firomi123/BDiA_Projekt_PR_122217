<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Wirtualny Dziekanat</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Wirtualny Dziekanat</a>
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" asp-controller="Students" asp-action="Index">Studenci</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Courses" asp-action="Index">Przedmioty</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Grades" asp-action="Index">Oceny</a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
