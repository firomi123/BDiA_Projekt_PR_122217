@model Grade
@{
    ViewData["Title"] = "Wystaw ocenę";
}

<h2>Wystaw ocenę</h2>

<form asp-action="Add" method="post">
    <div class="mb-2">
        <label asp-for="StudentId"></label>
        <select asp-for="StudentId" asp-items="ViewBag.Students" class="form-control"></select>
    </div>
    <div class="mb-2">
        <label asp-for="CourseId"></label>
        <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-control"></select>
    </div>
    <div class="mb-2">
        <label asp-for="Value"></label>
        <select asp-for="Value" class="form-control">
            <option value="2">2.0</option>
            <option value="3">3.0</option>
            <option value="3.5">3.5</option>
            <option value="4">4.0</option>
            <option value="4.5">4.5</option>
            <option value="5">5.0</option>
        </select>
        <span asp-validation-for="Value" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Date"></label>
        <input asp-for="Date" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Zapisz</button>
    <a asp-action="Index">Powrót</a>
</form>
